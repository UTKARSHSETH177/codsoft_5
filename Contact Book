def search():
    root = tk.Tk()
    root.title("Contacts Search")
    def search_contacts():
        search_term = search_entry.get()
        results = []
        for contact in contactlist:
            if search_term.lower() in contact[0].lower() or search_term in contact[1] or search_term.lower() in contact[2].lower() or search_term.lower() in contact[3].lower():
                results.append(contact)
        update_results(results)

    def update_results(results):
        for row in results_tree.get_children():
            results_tree.delete(row)
        for contact in results:
            results_tree.insert("", "end", values=(contact[0], contact[1], contact[2], contact[3]))

    def close_window():
        root.destroy()

# Step 4: Design the GUI
    
    frame = ttk.Frame(root)
